# Copia este archivo a .env y completa los valores.
# El archivo .env no se sube a git.

# Cloud name del dashboard de Cloudinary (API Keys).
# No uses el nombre del proyecto. Suele verse como: dxxxxxxxx
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Opcional. Si la usas, el Cloud name debe coincidir con CLOUDINARY_CLOUD_NAME.
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Opcional. Preset unsigned (Settings > Upload > Upload presets).
# CLOUDINARY_UPLOAD_PRESET=

# Sitio (se siembra en Settings la primera vez).
# SITE_NAME=Mi Tienda
# SITE_WHATSAPP=5491112345678
# SITE_GA=G-XXXXXXXX
# SITE_GTM=GTM-XXXXXXX

# Admin del storefront (login en /cuenta/ingresar).
# ADMIN_EMAIL=admin@local.test
# ADMIN_PASSWORD=Admin1234
