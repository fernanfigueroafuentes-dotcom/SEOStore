@model IEnumerable<SEOStore.Application.Features.Content.DTOs.BlogPostDto>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Blog</h1>
    <a class="btn btn-primary" asp-action="Create">Nueva nota</a>
</div>

@if (TempData["StatusMessage"] is string status)
{
    <div class="alert alert-success">@status</div>
}

<table class="table">
    <thead>
        <tr>
            <th>Título</th>
            <th>Slug</th>
            <th>Estado</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var post in Model)
    {
        <tr>
            <td>@post.Title</td>
            <td><code>/blog/@post.Slug</code></td>
            <td>@(post.Published ? "Publicada" : "Borrador")</td>
            <td class="text-end">
                <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@post.Id">Editar</a>
                @if (post.Published)
                {
                    <a class="btn btn-sm btn-outline-secondary" href="/blog/@post.Slug">Ver</a>
                }
                <form action="/admin/blog/@post.Id/eliminar" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('¿Eliminar esta nota?')">Eliminar</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
