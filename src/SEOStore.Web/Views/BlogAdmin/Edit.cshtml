@model SEOStore.Web.Models.Admin.BlogPostForm
@{
    var isNew = Model.Id == 0;
}

<h1 class="h3 mb-3">@(isNew ? "Nueva nota" : "Editar nota")</h1>

<form method="post" class="card p-4">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <input type="hidden" asp-for="Id" />
    <div class="mb-3">
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>
    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="Slug" class="form-label"></label>
            <input asp-for="Slug" class="form-control" placeholder="Se genera del título si lo dejás vacío" />
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="Author" class="form-label"></label>
            <input asp-for="Author" class="form-control" />
        </div>
    </div>
    <div class="mb-3">
        <label asp-for="Summary" class="form-label"></label>
        <textarea asp-for="Summary" class="form-control" rows="2"></textarea>
    </div>
    <div class="mb-3">
        <label asp-for="FeaturedImageUrl" class="form-label"></label>
        <input asp-for="FeaturedImageUrl" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Content" class="form-label"></label>
        <div id="content-editor" class="product-editor"></div>
        <textarea asp-for="Content" class="d-none"></textarea>
    </div>
    <div class="mb-3">
        <label asp-for="MetaTitle" class="form-label"></label>
        <input asp-for="MetaTitle" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="MetaDescription" class="form-label"></label>
        <textarea asp-for="MetaDescription" class="form-control" rows="2"></textarea>
    </div>
    <div class="form-check mb-2">
        <input asp-for="Published" class="form-check-input" />
        <label asp-for="Published" class="form-check-label"></label>
    </div>
    <div class="form-check mb-2">
        <input asp-for="Index" class="form-check-input" />
        <label asp-for="Index" class="form-check-label"></label>
    </div>
    <div class="form-check mb-4">
        <input asp-for="Follow" class="form-check-input" />
        <label asp-for="Follow" class="form-check-label"></label>
    </div>
    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">Guardar</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_QuillEditor" />
}
