@model SEOStore.Application.Features.Settings.DTOs.SiteSettingsDto

<h1 class="h3 mb-3">Sitio</h1>
<p class="text-muted">Nombre, contacto, colores y medición. Se ven en el layout público.</p>

@if (TempData["StatusMessage"] is string status)
{
    <div class="alert alert-success">@status</div>
}

<form asp-action="Edit" method="post" class="card p-4">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label asp-for="SiteName" class="form-label">Nombre del sitio</label>
        <input asp-for="SiteName" class="form-control" />
    </div>
    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="LogoUrl" class="form-label">Logo (URL)</label>
            <input asp-for="LogoUrl" class="form-control" />
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="FaviconUrl" class="form-label">Favicon (URL)</label>
            <input asp-for="FaviconUrl" class="form-control" />
        </div>
    </div>
    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="Phone" class="form-label">Teléfono</label>
            <input asp-for="Phone" class="form-control" />
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="Email" class="form-label">Email</label>
            <input asp-for="Email" class="form-control" />
        </div>
    </div>
    <div class="mb-3">
        <label asp-for="WhatsApp" class="form-label">WhatsApp (con código de país)</label>
        <input asp-for="WhatsApp" class="form-control" placeholder="5491112345678" />
    </div>
    <div class="mb-3">
        <label asp-for="Address" class="form-label">Dirección</label>
        <input asp-for="Address" class="form-control" />
    </div>
    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="Instagram" class="form-label">Instagram</label>
            <input asp-for="Instagram" class="form-control" />
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="Facebook" class="form-label">Facebook</label>
            <input asp-for="Facebook" class="form-control" />
        </div>
    </div>
    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="PrimaryColor" class="form-label">Color principal</label>
            <input asp-for="PrimaryColor" class="form-control" type="color" />
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="SecondaryColor" class="form-label">Color secundario</label>
            <input asp-for="SecondaryColor" class="form-control" type="color" />
        </div>
    </div>
    <div class="row">
        <div class="col-md-6 mb-3">
            <label asp-for="GoogleAnalytics" class="form-label">Google Analytics</label>
            <input asp-for="GoogleAnalytics" class="form-control" placeholder="G-XXXXXXXX" />
        </div>
        <div class="col-md-6 mb-3">
            <label asp-for="GoogleTagManager" class="form-label">Google Tag Manager</label>
            <input asp-for="GoogleTagManager" class="form-control" placeholder="GTM-XXXXXXX" />
        </div>
    </div>
    <button type="submit" class="btn btn-primary">Guardar</button>
</form>
