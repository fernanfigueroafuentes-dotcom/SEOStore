@model IEnumerable<SEOStore.Application.Features.Brands.DTOs.BrandDto>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Marcas</h1>
    <a class="btn btn-primary" asp-action="Create">Nueva marca</a>
</div>

@if (TempData["StatusMessage"] is string status)
{
    <div class="alert alert-success">@status</div>
}

<table class="table">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Slug</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var brand in Model)
    {
        <tr>
            <td>@brand.Name</td>
            <td><code>@brand.Slug</code></td>
            <td class="text-end">
                <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@brand.Id">Editar</a>
                <form action="/admin/marcas/@brand.Id/eliminar" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('¿Eliminar esta marca?')">Eliminar</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
