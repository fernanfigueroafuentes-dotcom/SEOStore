@model SEOStore.Web.Models.Admin.CategoryForm
@{
    var isNew = Model.Id == 0;
    ViewData["Title"] = isNew ? "Nueva categoría" : "Editar categoría";
}

<h1 class="h3 mb-3">@(isNew ? "Nueva categoría" : "Editar categoría")</h1>

<form method="post" class="card p-4">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <input type="hidden" asp-for="Id" />
    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
        <div class="form-text">Si cambiás el nombre, el slug público cambia y la URL vieja redirige con 301.</div>
    </div>
    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
    </div>
    <div class="mb-3">
        <label asp-for="MetaTitle" class="form-label"></label>
        <input asp-for="MetaTitle" class="form-control" maxlength="70" />
        <div class="form-text">Si lo dejás vacío, se usa el nombre.</div>
    </div>
    <div class="mb-3">
        <label asp-for="MetaDescription" class="form-label"></label>
        <textarea asp-for="MetaDescription" class="form-control" rows="2" maxlength="160"></textarea>
    </div>
    <div class="form-check mb-2">
        <input asp-for="Published" class="form-check-input" />
        <label asp-for="Published" class="form-check-label"></label>
    </div>
    <div class="form-check mb-2">
        <input asp-for="Index" class="form-check-input" />
        <label asp-for="Index" class="form-check-label"></label>
    </div>
    <div class="form-check mb-4">
        <input asp-for="Follow" class="form-check-input" />
        <label asp-for="Follow" class="form-check-label"></label>
    </div>
    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">Guardar</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
