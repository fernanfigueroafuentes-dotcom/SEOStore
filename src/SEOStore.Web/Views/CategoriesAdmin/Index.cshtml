@model IEnumerable<SEOStore.Application.Features.Categories.DTOs.CategoryDto>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Categorías</h1>
    <a class="btn btn-primary" asp-action="Create">Nueva categoría</a>
</div>

@if (TempData["StatusMessage"] is string status)
{
    <div class="alert alert-success">@status</div>
}

<table class="table">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Slug</th>
            <th>Estado</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var category in Model)
    {
        <tr>
            <td>@category.Name</td>
            <td><code>/categoria/@category.Slug</code></td>
            <td>@(category.Published ? "Publicada" : "Oculta")</td>
            <td class="text-end">
                <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@category.Id">Editar</a>
                @if (category.Published)
                {
                    <a class="btn btn-sm btn-outline-secondary" href="/categoria/@category.Slug">Ver</a>
                }
                <form action="/admin/categorias/@category.Id/eliminar" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('¿Eliminar esta categoría?')">Eliminar</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
