@model SEOStore.Application.Features.Content.DTOs.BlogPostDto

<nav class="mb-3 small" aria-label="Migas de pan">
    <a href="/">Inicio</a>
    <span> / </span>
    <a href="/blog">Blog</a>
    <span> / </span>
    <span>@Model.Title</span>
</nav>

<article>
    <p class="text-muted small mb-2">
        @if (Model.PublishedAt is not null)
        {
            @Model.PublishedAt.Value.ToString("dd/MM/yyyy")
        }
        @if (!string.IsNullOrWhiteSpace(Model.Author))
        {
            <span> · @Model.Author</span>
        }
    </p>
    <h1 class="h3 mb-3">@Model.Title</h1>
    @if (!string.IsNullOrWhiteSpace(Model.FeaturedImageUrl))
    {
        <img class="img-fluid rounded mb-4" src="@Model.FeaturedImageUrl" alt="@Model.Title" loading="lazy" />
    }
    @if (!string.IsNullOrWhiteSpace(Model.Summary))
    {
        <p class="lead">@Model.Summary</p>
    }
    <div class="product-description-body">
        @ProductDescriptionHtml.ToHtml(Model.Content)
    </div>
</article>
