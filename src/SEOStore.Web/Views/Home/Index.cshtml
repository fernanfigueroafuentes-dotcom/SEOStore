@model SEOStore.Web.Models.Store.HomePageViewModel
@using SEOStore.Application.Features.Settings.DTOs
@{
    var site = ViewData["Site"] as SiteSettingsDto ?? new SiteSettingsDto();
}

<div class="py-4">
    @if (Model.Banners.Count > 0)
    {
        <h1 class="visually-hidden">@site.SiteName</h1>
        <div id="home-banners" class="carousel slide mb-4" data-bs-ride="carousel">
            @if (Model.Banners.Count > 1)
            {
                <div class="carousel-indicators">
                    @for (var i = 0; i < Model.Banners.Count; i++)
                    {
                        <button type="button" data-bs-target="#home-banners" data-bs-slide-to="@i" class="@(i == 0 ? "active" : null)" aria-current="@(i == 0 ? "true" : null)" aria-label="Banner @(i + 1)"></button>
                    }
                </div>
            }
            <div class="carousel-inner rounded">
                @for (var i = 0; i < Model.Banners.Count; i++)
                {
                    var banner = Model.Banners[i];
                    <div class="carousel-item @(i == 0 ? "active" : null)">
                        @if (!string.IsNullOrWhiteSpace(banner.Link))
                        {
                            <a href="@banner.Link" class="text-decoration-none">
                                <img src="@banner.ImageUrl" class="d-block w-100 home-banner-img" alt="@banner.Title" />
                            </a>
                        }
                        else
                        {
                            <img src="@banner.ImageUrl" class="d-block w-100 home-banner-img" alt="@banner.Title" />
                        }
                        <div class="carousel-caption">
                            <h2 class="h3">@banner.Title</h2>
                            @if (!string.IsNullOrWhiteSpace(banner.Subtitle))
                            {
                                <p class="mb-0">@banner.Subtitle</p>
                            }
                        </div>
                    </div>
                }
            </div>
            @if (Model.Banners.Count > 1)
            {
                <button class="carousel-control-prev" type="button" data-bs-target="#home-banners" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Anterior</span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#home-banners" data-bs-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Siguiente</span>
                </button>
            }
        </div>
    }
    else
    {
        <h1 class="h2 mb-3">@site.SiteName</h1>
        <p class="lead">Catálogo de productos. Elegí una categoría o mirá los destacados.</p>
        <a class="btn btn-primary" href="/productos">Ver productos</a>
    }
</div>

@if (Model.Categories.Count > 0)
{
    <section class="mb-5">
        <h2 class="h4 mb-3">Categorías</h2>
        <div class="row g-3">
            @foreach (var category in Model.Categories)
            {
                <div class="col-6 col-md-4 col-lg-3">
                    <a class="text-decoration-none" href="/categoria/@category.Slug">
                        <div class="border rounded p-3 h-100">
                            <h3 class="h6 mb-1 text-dark">@category.Name</h3>
                            @if (!string.IsNullOrWhiteSpace(category.Description))
                            {
                                <p class="small text-muted mb-0">@category.Description</p>
                            }
                        </div>
                    </a>
                </div>
            }
        </div>
    </section>
}

@if (Model.Featured.Count > 0)
{
    <section class="mb-4">
        <h2 class="h4 mb-3">Destacados</h2>
        <div class="row g-3">
            @foreach (var product in Model.Featured)
            {
                <div class="col-12 col-sm-6 col-lg-3">
                    <partial name="_ProductCard" model="product" />
                </div>
            }
        </div>
    </section>
}
