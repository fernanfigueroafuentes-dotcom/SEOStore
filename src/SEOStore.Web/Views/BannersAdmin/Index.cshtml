@model IEnumerable<SEOStore.Application.Features.Banners.DTOs.BannerDto>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Banners</h1>
    <a class="btn btn-primary" asp-action="Create">Nuevo banner</a>
</div>

@if (TempData["StatusMessage"] is string status)
{
    <div class="alert alert-success">@status</div>
}

<p class="text-muted">Se muestran en el inicio, en orden, si están activos y tienen imagen.</p>

<table class="table">
    <thead>
        <tr>
            <th>Título</th>
            <th>Orden</th>
            <th>Estado</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var banner in Model)
    {
        <tr>
            <td>@banner.Title</td>
            <td>@banner.DisplayOrder</td>
            <td>@(banner.Active ? "Activo" : "Oculto")</td>
            <td class="text-end">
                <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@banner.Id">Editar</a>
                <form action="/admin/banners/@banner.Id/eliminar" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('¿Eliminar este banner?')">Eliminar</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
