@model IEnumerable<SEOStore.Application.Features.Products.DTOs.ProductDto>
@{
    ViewData["Title"] = "Productos";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">Productos</h1>
        <p class="text-muted mb-0">Carga inicial del catálogo con fotos.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">Nuevo producto</a>
</div>

@if (TempData["StatusMessage"] is string status)
{
    <div class="alert alert-success">@status</div>
}

@if (!Model.Any())
{
    <div class="alert alert-light border">
        Todavía no hay productos. <a asp-action="Create">Carga el primero</a>.
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var product in Model)
        {
            <div class="col-12 col-sm-6 col-lg-4">
                <a class="text-decoration-none text-dark" href="/producto/@product.Slug">
                    <div class="card h-100 catalog-card">
                        @if (!string.IsNullOrWhiteSpace(product.ThumbnailUrl))
                        {
                            <img class="card-img-top catalog-thumb"
                                 src="@ProductImageUrl.Card(product.ThumbnailUrl)"
                                 alt="@product.Name"
                                 width="@ProductImageUrl.CardWidth"
                                 height="@ProductImageUrl.CardHeight"
                                 loading="lazy" />
                        }
                        else
                        {
                            <div class="catalog-thumb catalog-thumb-empty">Sin foto</div>
                        }
                        <div class="card-body">
                            <h2 class="h5 mb-1">@product.Name</h2>
                            @if (product.ShowPrice)
                            {
                                <p class="mb-0">@product.Price.ToString("C")</p>
                            }
                            else
                            {
                                <p class="mb-0 text-muted">Precio oculto</p>
                            }
                        </div>
                    </div>
                </a>
            </div>
        }
    </div>
}
